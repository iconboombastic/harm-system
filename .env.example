# ============================================
# HARM SYSTEM - Environment Variables
# ============================================
# Salin file ini menjadi .env.local dan isi nilainya
# cp .env.example .env.local

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HARM - Sistem Harmonisasi Dokumen Terpadu

# ----- Google Drive (Opsional) -----
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ----- Email (Opsional) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@harm.acehtamiang.go.id
